{
  "openapi": "3.0.3",
  "info": {
    "title": "UrbanLink Flow API",
    "version": "3.14.0",
    "description": "API REST para usuários, frota, entregas, rastreamento, planejamento de rotas e atendimento."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Mensagem": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "senha": {
            "type": "string",
            "minLength": 8
          },
          "perfil": {
            "type": "string",
            "enum": [
              "Cliente",
              "Motorista",
              "Administrador"
            ]
          }
        }
      },
      "Cadastro": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "senha": {
            "type": "string",
            "minLength": 8
          },
          "perfil": {
            "type": "string",
            "enum": [
              "Cliente",
              "Motorista",
              "Administrador"
            ]
          },
          "telefone": {
            "type": "string"
          },
          "cpf_cnpj": {
            "type": "string"
          },
          "cep": {
            "type": "string"
          },
          "cnh": {
            "type": "string"
          },
          "codigo_convite": {
            "type": "string"
          }
        }
      },
      "Entrega": {
        "type": "object",
        "required": [
          "destino",
          "destinatario_nome",
          "tipo_veiculo"
        ],
        "properties": {
          "cliente_id": {
            "type": "integer"
          },
          "origem": {
            "type": "string"
          },
          "destino": {
            "type": "string"
          },
          "destino_latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "destino_longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "destinatario_nome": {
            "type": "string"
          },
          "destinatario_telefone": {
            "type": "string"
          },
          "cep_entrega": {
            "type": "string"
          },
          "bairro": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "tipo_veiculo": {
            "type": "string",
            "enum": [
              "Moto",
              "Carro",
              "Van",
              "Caminhão",
              "Elétrico"
            ]
          },
          "tipo_carga": {
            "type": "string"
          },
          "quantidade_volumes": {
            "type": "integer",
            "minimum": 1
          },
          "peso_kg": {
            "type": "number",
            "minimum": 0
          },
          "volume_m3": {
            "type": "number",
            "minimum": 0
          },
          "janela_inicio": {
            "type": "string",
            "example": "09:00"
          },
          "janela_fim": {
            "type": "string",
            "example": "11:30"
          },
          "observacoes": {
            "type": "string"
          }
        }
      },
      "Veiculo": {
        "type": "object",
        "required": [
          "placa",
          "modelo",
          "tipo"
        ],
        "properties": {
          "placa": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Moto",
              "Carro",
              "Van",
              "Caminhão",
              "Elétrico"
            ]
          },
          "cor": {
            "type": "string"
          },
          "ano": {
            "type": "integer"
          },
          "capacidade_kg": {
            "type": "number"
          },
          "tipo_combustivel": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Verifica disponibilidade da API",
        "responses": {
          "200": {
            "description": "API disponível"
          }
        }
      }
    },
    "/auth/cadastro": {
      "post": {
        "summary": "Cadastra cliente, motorista ou administrador com convite",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Cadastro"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conta criada"
          },
          "403": {
            "description": "Convite inválido"
          },
          "409": {
            "description": "Cadastro duplicado"
          },
          "422": {
            "description": "Dados inválidos"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Autentica usuário e retorna JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login concluído"
          },
          "401": {
            "description": "Credenciais inválidas"
          },
          "403": {
            "description": "Perfil incompatível"
          }
        }
      }
    },
    "/auth/codigo-recuperacao": {
      "post": {
        "summary": "Gerar ou substituir o código de recuperação da conta",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["senha"],
                "properties": { "senha": { "type": "string", "format": "password" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Código revelado uma única vez",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "codigo": { "type": "string" } }
                }
              }
            }
          },
          "401": { "description": "Autenticação necessária" },
          "403": { "description": "Senha atual incorreta" },
          "409": { "description": "Conta alterada durante a solicitação" },
          "422": { "description": "Senha atual ausente" }
        }
      }
    },
    "/auth/redefinir-senha": {
      "post": {
        "summary": "Redefinir a senha e consumir o código de recuperação",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "codigo", "senha"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "codigo": { "type": "string" },
                  "senha": { "type": "string", "format": "password", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Senha redefinida e sessões anteriores invalidadas" },
          "422": { "description": "Dados inválidos ou código indisponível" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Retorna o usuário autenticado",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil do usuário"
          },
          "401": {
            "description": "Não autenticado"
          }
        }
      }
    },
    "/usuarios": {
      "get": {
        "summary": "Lista usuários com filtros e paginação (Administrador/Gestor)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "perfil",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aprovado",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada"
          },
          "403": {
            "description": "Sem permissão"
          }
        }
      }
    },
    "/usuarios/me": {
      "get": {
        "summary": "Consulta o próprio perfil",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil"
          }
        }
      },
      "patch": {
        "summary": "Atualiza dados de contato e documento da CNH",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil atualizado"
          }
        }
      }
    },
    "/usuarios/{id}/aprovacao": {
      "patch": {
        "summary": "Aprova ou reprova motorista (Administrador/Gestor)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "aprovado"
                ],
                "properties": {
                  "aprovado": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aprovação atualizada"
          },
          "403": {
            "description": "Sem permissão"
          }
        }
      }
    },
    "/veiculos": {
      "get": {
        "summary": "Lista frota",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Veículos"
          }
        },
        "description": "Resultados paginados (parâmetros pagina e limite; limite máximo 100). Clientes visualizam somente veículos de suas entregas ativas; motoristas somente o veículo vinculado.",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ]
      },
      "post": {
        "summary": "Cadastra veículo (Administrador/Gestor)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Veiculo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Veículo cadastrado"
          },
          "409": {
            "description": "Placa duplicada"
          }
        }
      }
    },
    "/veiculos/me": {
      "post": {
        "summary": "Motorista cadastra veículo próprio",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Veiculo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Veículo cadastrado"
          },
          "409": {
            "description": "Veículo já vinculado"
          }
        }
      }
    },
    "/veiculos/{id}/posicoes": {
      "get": {
        "summary": "Lista histórico de posições",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Histórico"
          }
        },
        "description": "Clientes consultam somente a última posição publicada após a atribuição de uma entrega ativa própria. Motoristas acessam apenas seu veículo; equipe administrativa acessa o histórico até 100 posições."
      },
      "post": {
        "summary": "Registra posição GPS do veículo",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "latitude",
                  "longitude"
                ],
                "properties": {
                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  },
                  "velocidade_kmh": {
                    "type": "number"
                  },
                  "status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Posição registrada"
          },
          "422": {
            "description": "Coordenadas inválidas"
          }
        }
      }
    },
    "/entregas": {
      "get": {
        "summary": "Lista entregas do usuário ou da operação com paginação e filtro",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "busca",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entregas"
          }
        }
      },
      "post": {
        "summary": "Solicita ou registra entrega",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Entrega"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Entrega criada"
          },
          "422": {
            "description": "Regra de negócio/validação"
          }
        }
      }
    },
    "/entregas/{id}": {
      "get": {
        "summary": "Consulta detalhes e histórico de uma entrega",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entrega"
          },
          "404": {
            "description": "Não encontrada"
          }
        }
      },
      "delete": {
        "summary": "Remove entrega pendente (Administrador)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removida"
          },
          "409": {
            "description": "Entrega já despachada"
          }
        }
      }
    },
    "/entregas/{id}/status": {
      "patch": {
        "summary": "Atualiza status respeitando o fluxo permitido",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "descricao": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status atualizado"
          },
          "403": {
            "description": "Sem permissão"
          },
          "422": {
            "description": "Transição inválida"
          }
        }
      }
    },
    "/entregas/{id}/atribuicao": {
      "patch": {
        "summary": "Atribui motorista e veículo (Administrador/Gestor)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "motorista_id",
                  "veiculo_id"
                ],
                "properties": {
                  "motorista_id": {
                    "type": "integer"
                  },
                  "veiculo_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atribuição concluída"
          },
          "409": {
            "description": "Veículo ocupado"
          }
        }
      }
    },
    "/rastreamento/{codigo}": {
      "get": {
        "summary": "Rastreia entrega conferindo o e-mail do solicitante",
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Andamento da entrega"
          },
          "404": {
            "description": "Código/e-mail não correspondem"
          }
        }
      }
    },
    "/entregas/exportar.csv": {
      "get": {
        "summary": "Exporta relatório CSV (Administrador/Gestor)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo CSV"
          }
        }
      }
    },
    "/rotas": {
      "get": {
        "summary": "Lista rotas do motorista ou da operação",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Rotas"
          }
        },
        "description": "Resultados paginados (parâmetros pagina e limite; limite máximo 100).",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ]
      }
    },
    "/rotas/otimizar": {
      "post": {
        "summary": "Otimiza a ordem das entregas por vizinho mais próximo e Haversine",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "entrega_ids",
                  "origem"
                ],
                "properties": {
                  "entrega_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "motorista_id": {
                    "type": "integer"
                  },
                  "origem": {
                    "type": "object",
                    "required": [
                      "latitude",
                      "longitude"
                    ],
                    "properties": {
                      "latitude": {
                        "type": "number"
                      },
                      "longitude": {
                        "type": "number"
                      }
                    }
                  },
                  "velocidade_media_kmh": {
                    "type": "number",
                    "default": 30
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rota persistida"
          },
          "422": {
            "description": "Coordenadas ou lista inválidas"
          }
        }
      }
    },
    "/rotas/{id}/status": {
      "patch": {
        "summary": "Atualiza status da rota",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rota atualizada"
          }
        }
      }
    },
    "/chamados": {
      "get": {
        "summary": "Lista chamados do usuário ou da equipe de atendimento",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Chamados"
          }
        },
        "description": "Resultados paginados (parâmetros pagina e limite; limite máximo 100).",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
