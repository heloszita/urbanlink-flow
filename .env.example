# Banco MySQL (local ou provedor externo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urbanlink_flow
DB_USER=root
DB_PASSWORD=
DB_SSL=false
# Certificado PEM da autoridade do banco, quando o provedor usa uma CA privada.
DB_SSL_CA=
DB_POOL_MAX=2

# Segredo aleatório com pelo menos 24 caracteres
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-24-caracteres
JWT_EXPIRES_IN=8h

# Código privado exigido no cadastro do administrador; o valor abaixo É RECUSADO por segurança.
# Execute `npm run configurar` para gerar automaticamente um código privado e um JWT_SECRET.
# Nunca use esta linha como código de cadastro!
ADMIN_INVITE_CODE=troque-por-um-codigo-privado

# Em produção, mantenha false e aplique o schema/migrations separadamente
DB_SYNC=false
NODE_ENV=development
PORT=3000

# Contatos exibidos nos cartões de atendimento (preencha com os contatos reais da equipe)
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Localização automática de endereços (utilizada em pedidos enviados pelos clientes).
# Para testes de baixo volume, o padrão usa Nominatim público com cache em memória.
# Para vários usuários / produção, prefira provedor contratado ou instância própria.
GEOCODING_ENABLED=true
GEOCODING_PROVIDER=nominatim
# Contato recomendado pelo provedor público; use e-mail válido se optar pelo Nominatim.
GEOCODING_CONTACT_EMAIL=
# Se trocar para GEOCODING_PROVIDER=geoapify, forneça a chave do seu projeto.
GEOCODING_API_KEY=
